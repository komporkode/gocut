{
  "name": "gocut",
  "version": "0.7.0-beta",
  "private": true,
  "description": "GoCut - Fast, lightweight offline desktop video editor powered by Go, Wails, and React",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-plugin-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "icons": "tsx scripts/generate-icon.ts",
    "licenses": "tsx scripts/licenses.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "media:build": "node scripts/build-media-tools.mjs",
    "assets": "tsx scripts/generate-assets.ts",
    "plugin:pack": "node scripts/package-plugin.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "jsdom": "^27.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "author": "ReaCut contributors"
}
